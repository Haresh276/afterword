# Pick ONE model. Gemini has a free tier (aistudio.google.com/apikey).
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional override for any OpenAI-compatible endpoint:
# LLM_API_KEY=  LLM_BASE_URL=  LLM_MODEL=

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Blank = offline emulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Email of the sandbox PERSONAL account named "Lakshmi Narayanan"
DEMO_CLIENT_EMAIL=

AFTERWORD_SEED_ON_START=1
AFTERWORD_MIN_SCORE=0.8
AFTERWORD_AUTOPILOT_DELAY=2-6
