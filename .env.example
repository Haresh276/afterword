# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave empty to run on the built-in offline PayPal simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Pick ONE LLM. Gemini has a free tier (aistudio.google.com/apikey); OpenAI is the documented toolkit path.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional overrides for any OpenAI-compatible endpoint:
# LLM_API_KEY=  LLM_BASE_URL=  LLM_MODEL=

# Email of your SANDBOX PERSONAL (buyer) account. Demo invoices go here so you can pay them on camera.
DEMO_CLIENT_EMAIL=

# Safety rails
PROOFPAY_AMOUNT_CEILING=10000
PROOFPAY_PROOF_THRESHOLD=0.7
PROOFPAY_BUSINESS_NAME=
# 1 = load demo contracts on first boot
PROOFPAY_SEED_ON_START=1
